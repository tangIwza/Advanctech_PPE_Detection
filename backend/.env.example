# Documentation only: set these in the process environment before starting.
PPE_ENV=development
PPE_MODEL_PATH=models/best.pt
PPE_DATA_DIR=backend/data
PPE_FRONTEND_DIR=frontend/dist
PPE_DEVICE=cpu
PPE_IMAGE_SIZE=640
PPE_MAX_FPS=15
PPE_MAX_UPLOAD_MB=500
PPE_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000,http://127.0.0.1:5173,http://localhost:5173
# Production requires a random token of at least 32 URL-safe characters.
# Set PPE_API_TOKEN in the deployment's secret environment.

